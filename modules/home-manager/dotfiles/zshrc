function squish {
  if [ -z "$1" ]; then
    BRANCH=origin/main
  else
    BRANCH=$1
  fi
  git rebase -i $(git merge-base -a HEAD $BRANCH)
}

toggle-audio () {
  if [[ "$(SwitchAudioSource -c)" == "Shure MV7" ]]; then
    SwitchAudioSource -s 'CalDigit TS4 Audio - Rear'
  else
    SwitchAudioSource -s 'Shure MV7'
  fi
}

# Cached kubectl completion (regenerate with: rm ~/.cache/kubectl-completion.zsh)
# Only generate when the tool is installed, and remove the cache if generation
# fails so an empty file is not sourced forever on hosts without kubectl.
if [[ ! -f ~/.cache/kubectl-completion.zsh ]] && (( $+commands[kubectl] )); then
  mkdir -p ~/.cache
  kubectl completion zsh > ~/.cache/kubectl-completion.zsh 2>/dev/null || rm -f ~/.cache/kubectl-completion.zsh
fi
[[ -f ~/.cache/kubectl-completion.zsh ]] && source ~/.cache/kubectl-completion.zsh
(( $+functions[_kubectl] )) && compdef kubecolor=kubectl

# Cached dagger completion (regenerate with: rm ~/.cache/dagger-completion.zsh)
if [[ ! -f ~/.cache/dagger-completion.zsh ]] && (( $+commands[dagger] )); then
  mkdir -p ~/.cache
  dagger completion zsh > ~/.cache/dagger-completion.zsh 2>/dev/null || rm -f ~/.cache/dagger-completion.zsh
fi
[[ -f ~/.cache/dagger-completion.zsh ]] && source ~/.cache/dagger-completion.zsh
(( $+functions[_dagger] )) && compdef _dagger dagger

# Source ~/.env if it exists (set -a auto-exports all variables)
[[ -f ~/.env ]] && { set -a; source ~/.env; set +a; }

bindkey '^a' autosuggest-accept
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#8ce6e6"
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
